{
  "id": "b0d43a70-f700-4a36-9b19-17cf35423902",
  "name": "02 - WhatsApp - Lembretes de pagamento",
  "nodes": [
    {
      "id": "followup-schedule",
      "name": "Followup Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "cancel-ineligible",
      "name": "Cancel Ineligible Followups",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -540,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups f\nSET status = 'cancelled', processing_started_at = NULL\nFROM contacts c, sales s\nWHERE f.contact_id = c.id AND f.sale_id = s.id\n  AND f.status IN ('pending', 'processing')\n  AND (c.state <> 'awaiting_payment' OR s.status <> 'pending')\nRETURNING f.id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "name": "Postgres - vendas"
        }
      }
    },
    {
      "id": "claim-followups",
      "name": "Claim Due Followups",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidates AS (\n  SELECT f.id\n  FROM followups f\n  JOIN contacts c ON c.id = f.contact_id\n  JOIN sales s ON s.id = f.sale_id\n  WHERE c.state = 'awaiting_payment' AND s.status = 'pending'\n    AND ((f.status = 'pending' AND f.scheduled_at <= NOW())\n      OR (f.status = 'processing' AND f.processing_started_at < NOW() - INTERVAL '10 minutes'))\n  ORDER BY f.scheduled_at\n  LIMIT 20\n  FOR UPDATE SKIP LOCKED\n), claimed AS (\n  UPDATE followups f SET status = 'processing', processing_started_at = NOW(), last_error = NULL\n  FROM candidates x WHERE f.id = x.id\n  RETURNING f.id, f.contact_id, f.sale_id, f.sequence_number\n)\nSELECT claimed.id, claimed.contact_id AS \"contactId\", claimed.sale_id AS \"saleId\",\n       claimed.sequence_number AS sequence, c.phone, c.display_name AS \"displayName\",\n       COALESCE((SELECT value FROM app_config WHERE key = 'evolution_instance'), 'kit-matematica') AS \"evolutionInstance\"\nFROM claimed JOIN contacts c ON c.id = claimed.contact_id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "name": "Postgres - vendas"
        }
      }
    },
    {
      "id": "build-followup",
      "name": "Build Followup Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "parameters": {
        "jsCode": "function firstName(name) {\n  return String(name || '').trim().split(/\\s+/).filter(Boolean)[0] || 'Prof';\n}\n\nreturn $input.all().flatMap((item) => {\n  const base = item.json;\n  const name = firstName(base.displayName);\n  const messages = {\n    1: ['Você conseguiu efetuar o pagamento?'],\n    2: [`Oi ${name}, deu certo o pagamento?`],\n    3: [\n      'Oi Prof!',\n      'Vi que você ainda não finalizou seu acesso...',\n      'Você consegue honrar com o compromisso que fizemos no começo da conversa?',\n    ],\n  };\n  return (messages[base.sequence] || []).map((text, messageIndex) => ({\n    json: { ...base, text, messageIndex },\n  }));\n});"
      }
    },
    {
      "id": "send-followup",
      "name": "Send Followup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution-api:8080/message/' + ('sendText/' + $json.evolutionInstance) }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $json.phone, text: $json.text, delay: 700, linkPreview: false }) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Evolution API - apikey"
        }
      }
    },
    {
      "id": "followup-success",
      "name": "Followup Successful",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        340,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "operator": {
                "type": "object",
                "operation": "notExists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mark-followup-sent",
      "name": "Mark Followup Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        560,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups SET status = 'sent', sent_at = NOW(), processing_started_at = NULL WHERE id = $1 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Claim Due Followups').item.json.id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "Postgres - vendas"
        }
      }
    },
    {
      "id": "mark-followup-failed",
      "name": "Mark Followup Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        560,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups SET status = 'failed', failed_at = NOW(), processing_started_at = NULL, last_error = LEFT($2, 1000) WHERE id = $1 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Claim Due Followups').item.json.id, $json.error?.message || 'Falha ao enviar lembrete' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "Postgres - vendas"
        }
      }
    }
  ],

    {
      "id": "normalize-event",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        0
      ],
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nconst data = payload.data ?? {};\nconst key = data.key ?? {};\nconst message = data.message ?? {};\nconst remoteJid = String(key.remoteJid ?? data.remoteJid ?? '');\nconst messageTypeRaw = String(data.messageType ?? '');\nconst text = String(message.conversation ?? message.extendedTextMessage?.text ?? message.imageMessage?.caption ?? '').trim();\nconst simplified = text.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/\\s+/g, ' ').trim();\nconst isImage = messageTypeRaw === 'imageMessage' || Boolean(message.imageMessage);\nlet intent = 'other';\nif (isImage) intent = 'receipt';\nelse if (/(^|\\b)(parar|para|cancelar|cancela|sair|remover|remove|tirar|tira|nao quero|não quero)(\\b|$)/.test(simplified)) intent = 'stop';\nelse if (/^(sim|quero|pode|pode enviar|manda|envia|vou querer)$/.test(simplified)) intent = 'affirmative';\nelse if (/^(nao|não|agora nao|agora não)$/.test(simplified)) intent = 'negative';\nelse if (/(kit|matematica|matemática|comprar|adquirir|atividades)/.test(simplified)) intent = 'purchase';\nconst externalId = String(key.id ?? data.id ?? '');\nconst timestamp = Number(data.messageTimestamp ?? Math.floor(Date.now() / 1000));\nconst ignored = payload.event !== 'messages.upsert' || !externalId || Boolean(key.fromMe) || remoteJid.endsWith('@g.us') || (!text && !isImage);\nreturn [{ json: {\n  externalId, instance: String(payload.instance ?? ''),\n  whatsappId: remoteJid, phone: remoteJid.split('@')[0].replace(/\\D/g, ''),\n  displayName: String(data.pushName ?? '').slice(0, 120), fromMe: Boolean(key.fromMe),\n  isGroup: remoteJid.endsWith('@g.us'), messageType: isImage ? 'image' : 'text',\n  text: text.slice(0, 4000), intent, ignored,\n  mediaReference: String(message.imageMessage?.url ?? (isImage ? `evolution-media:${externalId}` : '')),\n  eventAt: new Date(timestamp * 1000).toISOString()\n} }];"
      }
    },

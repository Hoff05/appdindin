      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst manifestPath = '/files/manifest.json';\nif (!fs.existsSync(manifestPath)) throw new Error('Copie manifest.example.json para manifest.json e configure os materiais.');\nconst manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\nif (!Array.isArray(manifest.documents) || manifest.documents.length !== 9) throw new Error('O manifesto precisa conter nove PDFs.');\nconst base = $('Route State').item.json;\nreturn manifest.documents.sort((a,b) => a.order - b.order).map((doc) => ({ json: { ...base, file: path.join('/files', doc.file), displayName: doc.displayName, driveUrl: manifest.driveUrl || base.materialsDriveUrl || '' } }));"

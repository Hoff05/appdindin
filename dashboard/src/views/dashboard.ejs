<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Visão geral — Painel de vendas</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/chart.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/"><span class="brand-mark small">Z</span><span>Painel de vendas</span></a>
    <nav class="nav-actions"><a class="text-link" href="/messages">Mensagens</a></nav>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button ghost" type="submit">Sair</button>
    </form>
  </header>
  <main class="container">
    <section class="heading-row">
      <div><p class="eyebrow">VISÃO GERAL</p><h1>Resultados do atendimento</h1></div>
      <p class="muted">Atualizado em <%= formatDate(new Date()) %></p>
    </section>
    <form class="filters" method="get" action="/">
      <label>De <input type="date" name="from" value="<%= filters.from || '' %>"></label>
      <label>Até <input type="date" name="to" value="<%= filters.to || '' %>"></label>
      <label class="grow">Buscar <input name="search" value="<%= filters.search || '' %>" placeholder="Nome ou telefone"></label>
      <button class="button secondary" type="submit">Filtrar</button>
    </form>
    <section class="cards" aria-label="Indicadores">
      <article class="metric featured"><span>Faturamento</span><strong><%= formatMoney(summary.revenue) %></strong><small>Pagamentos confirmados</small></article>
      <article class="metric"><span>Vendas pagas</span><strong><%= summary.paid %></strong><small>Pedidos concluídos</small></article>
      <article class="metric"><span>Pendentes</span><strong><%= summary.pending %></strong><small>Aguardando confirmação</small></article>
      <article class="metric"><span>Contatos</span><strong><%= summary.contacts %></strong><small>No período selecionado</small></article>
    </section>
    <section class="panel chart-panel">
      <div><p class="eyebrow">DESEMPENHO</p><h2>Vendas por dia</h2></div>
      <div id="sales-chart" class="chart" data-series="<%= JSON.stringify(daily) %>" aria-label="Gráfico de vendas por dia"></div>
    </section>
    <section class="panel">
      <div class="panel-title"><div><p class="eyebrow">CLIENTES</p><h2>Atendimentos recentes</h2></div><span class="pill"><%= contacts.length %> registros</span></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Cliente</th><th>Etapa</th><th>Valor</th><th>Data</th><th></th></tr></thead>
          <tbody>
            <% for (const item of contacts) { %>
              <tr>
                <td><strong><%= item.display_name || 'Sem nome' %></strong><small><%= item.phone %></small></td>
                <td><span class="status <%= item.status %>"><%= item.status %></span></td>
                <td><%= formatMoney(item.confirmed_amount || item.expected_amount) %></td>
                <td><%= formatDate(item.created_at) %></td>
                <td><a class="text-link" href="/contacts/<%= item.id %>">Ver detalhes →</a></td>
              </tr>
            <% } %>
            <% if (contacts.length === 0) { %><tr><td colspan="5" class="empty">Nenhum atendimento encontrado.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>

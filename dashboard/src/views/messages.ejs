<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mensagens — Painel de vendas</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/"><span class="brand-mark small">Z</span><span>Painel de vendas</span></a>
    <nav class="nav-actions"><a class="text-link" href="/">Dashboard</a></nav>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button ghost" type="submit">Sair</button>
    </form>
  </header>
  <main class="container">
    <section class="heading-row">
      <div><p class="eyebrow">AUTOMAÇÃO</p><h1>Gerenciar mensagens</h1></div>
      <p class="muted">As alterações valem para as próximas conversas no WhatsApp.</p>
    </section>
    <% if (saved) { %><p class="alert success">Mensagens salvas. O n8n lerá esta configuração na próxima conversa.</p><% } %>
    <form method="post" action="/messages" class="message-editor">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section class="panel">
        <div class="panel-title"><div><p class="eyebrow">FLUXO DE VENDA</p><h2>Mensagens enviadas ao cliente</h2></div></div>
        <div class="message-list">
          <% for (const key of stepOrder) { const step = settings.steps[key]; %>
            <article class="message-step">
              <div class="message-step-head">
                <div><strong><%= step.label %></strong><small><%= step.type %></small></div>
                <label class="check"><input type="checkbox" name="step_<%= key %>_enabled" <%= step.enabled ? 'checked' : '' %>> Ativo</label>
              </div>
              <div class="message-grid">
                <label>Delay em ms<input type="number" min="0" max="3600000" name="step_<%= key %>_delayMs" value="<%= step.delayMs || 0 %>"></label>
                <% if (step.type === 'image') { %>
                  <label>Arquivo da imagem<input name="step_<%= key %>_fileName" value="<%= step.fileName || '' %>"></label>
                  <label class="wide">Legenda<textarea name="step_<%= key %>_caption" rows="2"><%= step.caption || '' %></textarea></label>
                <% } %>
                <label class="wide">Texto<textarea name="step_<%= key %>_text" rows="<%= String(step.text || '').length > 120 ? 5 : 3 %>"><%= step.text || '' %></textarea></label>
              </div>
            </article>
          <% } %>
        </div>
      </section>
      <section class="panel">
        <div class="panel-title"><div><p class="eyebrow">COBRANÇAS</p><h2>Lembretes de pagamento</h2></div></div>
        <div class="message-list">
          <% for (const key of followupOrder) { const followup = settings.followups[key]; %>
            <article class="message-step">
              <div class="message-step-head">
                <div><strong><%= followup.label %></strong><small>Uma mensagem por linha</small></div>
                <label class="check"><input type="checkbox" name="followup_<%= key %>_enabled" <%= followup.enabled ? 'checked' : '' %>> Ativo</label>
              </div>
              <div class="message-grid">
                <label>Delay em minutos<input type="number" min="0" max="10080" name="followup_<%= key %>_delayMinutes" value="<%= followup.delayMinutes %>"></label>
                <label class="wide">Mensagens<textarea name="followup_<%= key %>_messages" rows="4"><%= followup.messages.join('\n') %></textarea></label>
              </div>
            </article>
          <% } %>
        </div>
      </section>
      <div class="sticky-actions"><button class="button primary" type="submit">Salvar mensagens</button></div>
    </form>
  </main>
</body>
</html>
